
<view class="page">

  <!-- 首页头部：第一张设计 -->
<view wx:if="{{!composerOpen}}" class="home-hero">

  <view class="home-eyebrow">
    A PLACE TO BE HEARD
  </view>

  <view class="home-title">
    这里有一片树洞
  </view>

  <view class="home-description">
    说出心里的话，也听听别人的事。
  </view>

</view>

<!-- 编辑状态头部：保留第二张设计 -->
<view wx:else>

  <view class="header">
    <text class="title">{{title}}</text>
    <text class="description">{{description}}</text>
  </view>

  <view class="notice">
    <text class="notice-text">
      发布前经过内容安全检查 · 内容 24 小时后自动焚毁
    </text>
  </view>

</view>

  <!-- 发布入口 -->
  <view
    wx:if="{{!composerOpen}}"
    class="composer-entry"
    bindtap="openComposer"
  >
    <text class="composer-entry-text">写下此刻的心情…</text>
    <text class="composer-entry-action">去发布</text>
  </view>

  <!-- 发布编辑区域：Figma 07 -->
  <view wx:else class="composer">

    <!-- 编辑区标题 -->
    <view class="composer-header">
      <view class="composer-heading">
        <view class="composer-eyebrow">SHARE YOUR FEELINGS</view>
        <view class="composer-title">写下此刻的心情</view>
        <view class="composer-subtitle">
          这里没有评判，只有倾听和理解
        </view>
      </view>

      <view
        class="composer-close"
        bindtap="closeComposer"
      >×</view>
    </view>

    <!-- 正文输入 -->
    <view class="input-section">
      <view class="section-label">想说的话</view>

      <textarea
        class="composer-input"
        placeholder="把心里的话写下来吧……"
        placeholder-class="composer-placeholder"
        value="{{content}}"
        maxlength="{{maxContentLength}}"
        bindinput="onContentInput"
        auto-height
      />

      <view class="composer-count">
        <text>{{content.length}}</text>
        <text>/{{maxContentLength}}</text>
      </view>
    </view>

    <!-- 情绪选择 -->
    <view class="emotion-section">
      <view class="section-heading">
        <view class="section-label">此刻的情绪</view>
        <view class="section-description">
          选择一种最接近你现在感受的情绪
        </view>
      </view>

      <view class="tag-list">
        <view
          wx:for="{{tags}}"
          wx:key="code"
          class="tag-item {{selectedTag === item.code ? 'selected' : ''}}"
          style="background:{{item.bg}}"
          data-code="{{item.code}}"
          bindtap="selectTag"
        >
          <text>{{item.label}}</text>
          <text
            wx:if="{{selectedTag === item.code}}"
            class="tag-check"
          >✓</text>
        </view>
      </view>
    </view>

    <!-- 匿名发布 -->
    <view class="anonymous-row">
      <view class="anonymous-info">
        <view class="anonymous-title">匿名发布</view>
        <view class="anonymous-hint">
          保护你的隐私，不展示昵称和头像
        </view>
      </view>

      <switch
        checked="{{anonymous}}"
        color="#789477"
        bindchange="onAnonymousChange"
      />
    </view>

    <!-- 发布操作 -->
    <view class="composer-buttons">
      <button
        class="btn-secondary"
        bindtap="closeComposer"
        disabled="{{submitting}}"
      >
        暂不发布
      </button>

      <button
        class="btn-primary"
        bindtap="submitPost"
        loading="{{submitting}}"
        disabled="{{submitting}}"
      >
        {{submitting ? '发布中...' : '发布到树洞'}}
      </button>
    </view>

    <!-- 安全提示 -->
    <view class="composer-hint">
      <text class="hint-icon">♡</text>
      你的表达值得被尊重，请友善分享
    </view>
  </view>



  <!-- 树洞内容区域：仅在未打开编辑器时显示 -->
  <view wx:if="{{!composerOpen}}">

    <!-- 加载状态 -->
    <view wx:if="{{loading && posts.length === 0}}" class="state-card">
      <text class="state-text">正在加载树洞…</text>
    </view>

    <!-- 错误状态 -->
    <view wx:elif="{{error && posts.length === 0}}" class="state-card">
      <text class="state-text">树洞加载失败</text>
      <text class="state-hint">
        请确认本地服务已启动，或稍后重试
      </text>
      <button class="retry-button" bindtap="retryLoad">
        重新加载
      </button>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{posts.length === 0}}" class="state-card">
      <text class="state-title">这里还很安静</text>
      <text class="state-hint">
        写下第一条心情，或下拉刷新试试
      </text>
    </view>

    <!-- 帖子列表 -->
    <view wx:else class="post-list">
      <view class="post-card" wx:for="{{posts}}" wx:key="id">
        <view class="post-head">
          <text class="post-tag" style="background:{{item.emotionBg}}">
            {{item.emotionLabel}}
          </text>
          <text class="post-author">{{item.authorText}}</text>
          <text wx:if="{{item.anonymous}}" class="post-anon">匿名</text>
        </view>

        <view class="post-content">{{item.content}}</view>

        <view class="post-foot">
          <text>{{item.createdText}}</text>
          <text>{{item.remainingText}}</text>
        </view>
      </view>

      <view wx:if="{{loadingMore}}" class="more-hint">
        正在加载更多…
      </view>
      <view wx:elif="{{moreError}}" class="more-hint">
        <text>加载更多失败，已加载的内容仍可查看</text>
        <button class="retry-button" bindtap="retryMore">重试加载更多</button>
      </view>
      <view wx:elif="{{hasMore}}" class="more-hint">
        上拉加载更多
      </view>
      <view wx:else class="more-hint">
        已显示全部
      </view>
    </view>

  </view>
  </view>
