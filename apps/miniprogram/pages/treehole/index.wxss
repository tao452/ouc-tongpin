page {
    min-height: 100%;
    background: #f7f8fa;
  }

  .page {
    min-height: 100vh;
    padding: 40rpx 32rpx;
    box-sizing: border-box;
  }

  .header {
    display: flex;
    flex-direction: column;
  }

  .title {
    font-size: 38rpx;
    font-weight: 700;
    color: #252a34;
  }

  .description {
    margin-top: 16rpx;
    font-size: 25rpx;
    color: #9298a5;
  }

  .empty-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-top: 60rpx;
    padding: 80rpx 30rpx;
    border-radius: 24rpx;
    background: #ffffff;
  }

  .empty-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #414957;
  }

  .empty-description {
    margin-top: 16rpx;
    font-size: 23rpx;
    color: #9298a5;
    text-align: center;
  }
