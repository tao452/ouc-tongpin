page {
  min-height: 100%;
  background: #f7f8fa;
}

.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 80rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  color: #252a34;
}

.description {
  margin-top: 16rpx;
  font-size: 25rpx;
  color: #9298a5;
}

.notice {
  margin-top: 24rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: #eaf2f4;
}

.notice-text {
  font-size: 23rpx;
  color: #426b7a;
}

/* 发布入口 */
.composer-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 30rpx 28rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.composer-entry-text {
  font-size: 27rpx;
  color: #9298a5;
}

.composer-entry-action {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #426b7a;
  color: #ffffff;
  font-size: 24rpx;
}

/* 发布表单 */
.composer {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.composer-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #252a34;
}

.composer-input {
  width: 100%;
  min-height: 160rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: #f7f8fa;
  font-size: 27rpx;
  line-height: 1.6;
  color: #252a34;
  box-sizing: border-box;
}

.composer-count {
  margin-top: 8rpx;
  text-align: right;
  font-size: 22rpx;
  color: #9298a5;
}

.section-label {
  margin-top: 24rpx;
  font-size: 25rpx;
  color: #414957;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.tag-item {
  margin: 0 14rpx 14rpx 0;
  padding: 12rpx 26rpx;
  border: 2rpx solid transparent;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #414957;
}

.tag-item.selected {
  border-color: #426b7a;
  font-weight: 600;
}

.anonymous-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eef0f3;
}

.anonymous-title {
  font-size: 26rpx;
  color: #414957;
}

.anonymous-hint {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #9298a5;
}

.composer-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.btn-secondary,
.btn-primary {
  flex: 1;
  margin: 0;
  font-size: 26rpx;
  border-radius: 14rpx;
}

.btn-secondary {
  background: #f0f2f5;
  color: #414957;
}

.btn-primary {
  background: #426b7a;
  color: #ffffff;
}

.composer-hint {
  margin-top: 18rpx;
  font-size: 21rpx;
  color: #9298a5;
  line-height: 1.5;
}

/* 筛选 */
.filter-bar {
  display: flex;
  flex-wrap: wrap;
  margin: 32rpx 0 20rpx;
}

.filter-item {
  margin: 0 14rpx 12rpx 0;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  font-size: 23rpx;
  color: #6b7280;
}

.filter-item.active {
  background: #426b7a;
  color: #ffffff;
}

/* 状态与列表 */
.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 70rpx 30rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.state-text,
.state-title {
  font-size: 28rpx;
  color: #414957;
}

.state-title {
  font-weight: 600;
}

.state-hint {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #9298a5;
  text-align: center;
}

.retry-button {
  margin-top: 28rpx;
  padding: 10rpx 36rpx;
  border-radius: 999rpx;
  background: #426b7a;
  color: #ffffff;
  font-size: 24rpx;
}

.post-card {
  margin-bottom: 20rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.post-head {
  display: flex;
  align-items: center;
}

.post-tag {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #414957;
}

.post-author {
  flex: 1;
  margin-left: 16rpx;
  font-size: 23rpx;
  color: #6b7280;
}

.post-anon {
  font-size: 21rpx;
  color: #9298a5;
}

.post-content {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #252a34;
  word-break: break-all;
}

.post-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0f2f5;
  font-size: 21rpx;
  color: #9298a5;
}

.more-hint {
  padding: 24rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: #9298a5;
}
