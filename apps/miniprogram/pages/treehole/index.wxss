
/* ==============================
   页面基础
============================== */

page {
  min-height: 100%;
  background: #F8F7F3;
  font-family: "HarmonyOS Sans SC", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 32rpx 40rpx 48rpx;
  box-sizing: border-box;
  background: #F8F7F3;
}

/* ==============================
   第二张：编辑页面头部
============================== */

.header {
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 38rpx;
  line-height: 1.5;
  font-weight: 700;
  color: #30352F;
}

.description {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #85877F;
}

/* ==============================
   第一张：树洞首页头部
============================== */

.home-hero {
  display: flex;
  flex-direction: column;
  padding-top: 12rpx;
}

.home-eyebrow {
  font-size: 21rpx;
  line-height: 1.5;
  letter-spacing: 4rpx;
  color: #8D9A88;
  font-weight: 500;
}

.home-title {
  margin-top: 22rpx;
  font-size: 46rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #30352F;
}

.home-description {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #85877F;
}


/* ==============================
   编辑页面：系统提示条
============================== */

.notice {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  margin-top: 28rpx;
  padding: 16rpx 24rpx;
  border-radius: 14rpx;
  background: #EEF4F2;
  box-sizing: border-box;
}

.notice-text {
  display: block;
  width: 100%;
  font-size: 23rpx;
  line-height: 1.5;
  color: #56776A;
}

/* ==============================
   发布入口
============================== */

.composer-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 36rpx;
  padding: 30rpx 26rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-sizing: border-box;
}

.composer-entry-text {
  font-size: 27rpx;
  color: #A7A79F;
}

.composer-entry-action {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #789477;
  color: #FFFFFF;
  font-size: 24rpx;
}

/* ==============================
   Figma 07：发布树洞编辑区域
============================== */

.composer {
  margin-top: 28rpx;
  padding: 36rpx 30rpx 28rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-sizing: border-box;
}

/* 编辑区标题 */

.composer-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.composer-heading {
  flex: 1;
}

.composer-eyebrow {
  font-size: 19rpx;
  line-height: 1.5;
  letter-spacing: 3rpx;
  color: #A7A79F;
}

.composer-title {
  margin-top: 10rpx;
  font-size: 34rpx;
  line-height: 1.5;
  font-weight: 700;
  color: #30352F;
}

.composer-subtitle {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #85877F;
}

/* 关闭按钮 */

.composer-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-left: 16rpx;
  border-radius: 50%;
  background: #F5F5F0;
  color: #85877F;
  font-size: 38rpx;
  line-height: 1;
}

/* 正文输入区域 */

.input-section {
  margin-top: 36rpx;
}

.section-label {
  font-size: 26rpx;
  line-height: 1.5;
  font-weight: 600;
  color: #30352F;
}

.composer-input {
  display: block;
  width: 100%;
  min-height: 220rpx;
  margin-top: 18rpx;
  padding: 24rpx;
  border: 2rpx solid #EAE9E2;
  border-radius: 16rpx;
  background: #FAFAF7;
  box-sizing: border-box;
  font-size: 27rpx;
  line-height: 1.8;
  color: #30352F;
}

.composer-placeholder {
  color: #A7A79F;
}

.composer-count {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #A7A79F;
}

/* 情绪选择 */

.emotion-section {
  margin-top: 36rpx;
}

.section-heading {
  display: flex;
  flex-direction: column;
}

.section-description {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #A7A79F;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 150rpx;
  min-height: 68rpx;
  margin: 0 16rpx 16rpx 0;
  padding: 12rpx 24rpx;
  border: 2rpx solid transparent;
  border-radius: 14rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  line-height: 1.5;
  color: #53584F;
}

.tag-item.selected {
  border-color: #789477;
  font-weight: 600;
}

.tag-check {
  margin-left: 10rpx;
  color: #789477;
  font-size: 23rpx;
  font-weight: 700;
}

/* ==============================
   匿名发布
============================== */

.anonymous-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 26rpx 0;
  border-top: 1rpx solid #EAE9E2;
  border-bottom: 1rpx solid #EAE9E2;
}

.anonymous-info {
  flex: 1;
  min-width: 0;
  padding-right: 18rpx;
}

.anonymous-title {
  font-size: 26rpx;
  line-height: 1.5;
  font-weight: 600;
  color: #30352F;
}

.anonymous-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #85877F;
}

/* ==============================
   底部操作按钮
============================== */

.composer-buttons {
  display: flex;
  gap: 18rpx;
  margin-top: 30rpx;
}

.btn-secondary,
.btn-primary {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: normal;
  font-weight: 500;
}

.btn-secondary::after,
.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #F3F3EE;
  color: #53584F;
}

.btn-primary {
  background: #789477;
  color: #FFFFFF;
}

.btn-primary[disabled] {
  opacity: 0.65;
}

/* 编辑页面底部提示 */

.composer-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #A7A79F;
}

.hint-icon {
  margin-right: 8rpx;
  color: #789477;
  font-size: 26rpx;
}

/* ==============================
   加载、错误、空状态
============================== */

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 30rpx;
  margin-top: 16rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-sizing: border-box;
}

.state-text,
.state-title {
  font-size: 28rpx;
  color: #30352F;
}

.state-title {
  font-weight: 600;
}

.state-hint {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #85877F;
  text-align: center;
}

.retry-button {
  margin-top: 28rpx;
  padding: 10rpx 36rpx;
  border-radius: 999rpx;
  background: #789477;
  color: #FFFFFF;
  font-size: 24rpx;
}

/* ==============================
   树洞帖子列表
============================== */

.post-list {
  width: 100%;
}

.post-card {
  margin-bottom: 20rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-sizing: border-box;
}

.post-head {
  display: flex;
  align-items: center;
}

.post-tag {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #53584F;
}

.post-author {
  flex: 1;
  margin-left: 16rpx;
  font-size: 23rpx;
  color: #85877F;
}

.post-anon {
  font-size: 21rpx;
  color: #A7A79F;
}

.post-content {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #30352F;
  word-break: break-all;
}

.post-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #EAE9E2;
  font-size: 21rpx;
  color: #A7A79F;
}

.more-hint {
  padding: 24rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: #A7A79F;
}
