.page {
    min-height: 100vh;
    box-sizing: border-box;
    padding: 48rpx 32rpx;
    background: #ffffff;
  }

  .title {
    font-size: 40rpx;
    font-weight: 600;
    color: #222831;
  }

  .description {
    margin-top: 20rpx;
    font-size: 28rpx;
    line-height: 1.6;
    color: #888888;
  }

  .form-card {
    margin-top: 48rpx;
    padding: 32rpx;
    border: 2rpx solid #e5e5e5;
    border-radius: 16rpx;
    background: #ffffff;
  }

  .form-item + .form-item {
    margin-top: 48rpx;
  }

  .label {
    margin-bottom: 20rpx;
    font-size: 30rpx;
    font-weight: 600;
    color: #333333;
  }

  .input {
    height: 88rpx;
    padding: 0 24rpx;
    border: 2rpx solid #dddddd;
    border-radius: 12rpx;
    font-size: 28rpx;
    color: #333333;
  }

  .upload-area {
    min-height: 240rpx;
    border: 2rpx dashed #cccccc;
    border-radius: 12rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fafafa;
  }

  .upload-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 26rpx;
    color: #888888;
  }

  .upload-icon {
    margin-bottom: 16rpx;
    font-size: 64rpx;
    line-height: 1;
    color: #666666;
  }

  .preview-image {
    width: 100%;
    height: 360rpx;
  }

  .tip {
    margin-top: 16rpx;
    font-size: 24rpx;
    line-height: 1.5;
    color: #999999;
  }

  .submit-button {
    height: 96rpx;
    margin-top: 64rpx;
    border: none;
    border-radius: 16rpx;
    background: #333333;
    color: #ffffff;
    font-size: 30rpx;
    font-weight: 600;
    line-height: 96rpx;
  }

  .submit-button::after {
    border: none;
  }

  .submit-button[disabled] {
    opacity: 0.5;
  }
