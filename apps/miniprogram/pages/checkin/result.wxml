
<view class="result-page">

  <!-- 成功状态 -->
  <view wx:if="{{success}}" class="result-content">

    <view class="result-decoration">
      <view class="result-icon success-icon">✓</view>
    </view>

    <view class="result-tag success-tag">CHECK IN COMPLETED</view>
    <view class="result-title">打卡成功！</view>
    <view class="result-desc">今天也认真地照顾了自己的心情</view>

    <view class="info-card">
      <view class="info-row">
        <text class="info-label">打卡日期</text>
        <text class="info-value">{{checkinDate}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">打卡状态</text>
        <text class="status-text">已完成</text>
      </view>
    </view>

    <view class="encourage-text">
      每一次记录，都是一次与自己的温柔相遇
    </view>

    <button class="action-button success-button" bindtap="goHome">
      返回打卡主页
    </button>

  </view>

  <!-- 失败状态 -->
  <view wx:else class="result-content">

    <view class="result-decoration fail-decoration">
      <view class="result-icon fail-icon">!</view>
    </view>

    <view class="result-tag fail-tag">SUBMISSION FAILED</view>
    <view class="result-title">打卡暂未完成</view>
    <view class="result-desc">别着急，我们可以再试一次</view>

    <view class="info-card">
      <view class="info-row">
        <text class="info-label">失败原因</text>
        <text class="info-value">{{errorReason}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">处理建议</text>
        <text class="info-value">{{errorSuggestion}}</text>
      </view>
    </view>

    <view class="encourage-text">
      你的心情值得被记录，稍后再试试吧
    </view>

    <button class="action-button retry-button" bindtap="retry">
      重新提交
    </button>

  </view>

</view>
