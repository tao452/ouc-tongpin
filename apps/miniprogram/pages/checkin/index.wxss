
/* 页面整体 */
.checkin-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx 32rpx 50rpx;
  background-color: #F8F7F3;
}

/* 日期氛围卡片 */
.date-hero {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  padding: 34rpx 32rpx 30rpx;
  margin-bottom: 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #E8EEE5 0%, #F0F3E9 100%);
}

.date-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date-eyebrow {
  font-size: 19rpx;
  letter-spacing: 2rpx;
  color: #789477;
  font-weight: 600;
}

.hero-small-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #91AA8D;
}

.date-today {
  margin-top: 42rpx;
  font-size: 27rpx;
  color: #657C63;
  font-weight: 500;
}

.date-number {
  margin-top: 8rpx;
  font-size: 66rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #30352F;
}

.date-description {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #858F7F;
}

.date-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 32rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(120, 148, 119, 0.18);
}

.date-bottom-text {
  display: flex;
  flex-direction: column;
}

.date-bottom-title {
  font-size: 25rpx;
  color: #536C51;
  font-weight: 600;
}

.date-bottom-subtitle {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #849380;
}

.sun-decoration {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sun-core {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background-color: #D9B978;
  box-shadow: 0 0 0 10rpx rgba(217, 185, 120, 0.16);
}

/* 今日打卡卡片 */
.status-card {
  box-sizing: border-box;
  padding: 30rpx;
  margin-bottom: 42rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #EFEEE8;
  border-radius: 26rpx;
  box-shadow: 0 8rpx 28rpx rgba(70, 75, 55, 0.035);
}

.status-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-eyebrow {
  font-size: 19rpx;
  letter-spacing: 1.5rpx;
  color: #A7A79F;
  font-weight: 600;
}

.status-badge {
  padding: 9rpx 18rpx;
  border-radius: 30rpx;
  background-color: #F7F1E6;
  color: #A58B5C;
  font-size: 21rpx;
}

.status-badge.badge-done {
  background-color: #E8EEE5;
  color: #789477;
}

.status-main {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  margin-bottom: 30rpx;
}

.status-icon {
  flex-shrink: 0;
  width: 94rpx;
  height: 94rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background-color: #F5F2E9;
  color: #B49C6C;
  font-size: 55rpx;
  font-weight: 400;
}

.status-icon.icon-done {
  background-color: #E8EEE5;
  color: #789477;
}

.status-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.status-text {
  font-size: 31rpx;
  font-weight: 650;
  color: #30352F;
}

.status-subtitle {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #96978F;
}

.status-button {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0;
  border-radius: 18rpx;
  background-color: #789477;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.status-button::after {
  border: none;
}

.status-button[disabled] {
  background-color: #E8EEE5;
  color: #789477;
  opacity: 1;
}

/* 通用模块标题 */
.section {
  margin-bottom: 42rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 650;
  color: #30352F;
}

.section-subtitle {
  margin-top: 9rpx;
  font-size: 22rpx;
  color: #A0A097;
}

.section-decoration {
  font-size: 38rpx;
  color: #A5B69D;
}

/* 数据卡片 */
.data-card {
  display: flex;
  align-items: center;
  padding: 34rpx 0;
  border-radius: 24rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #EFEEE8;
  box-shadow: 0 8rpx 28rpx rgba(70, 75, 55, 0.025);
}

.data-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.data-number {
  font-size: 58rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #789477;
}

.data-label {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #555D52;
  font-weight: 500;
}

.data-unit {
  margin-top: 5rpx;
  font-size: 21rpx;
  color: #A7A79F;
}

.data-divider {
  width: 1rpx;
  height: 100rpx;
  background-color: #EFEEE8;
}

/* 更多功能 */
.more-section {
  margin-bottom: 28rpx;
}

.more-card {
  padding: 0 26rpx;
  border-radius: 24rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #EFEEE8;
  box-shadow: 0 8rpx 28rpx rgba(70, 75, 55, 0.025);
}

.more-item {
  display: flex;
  align-items: center;
  min-height: 112rpx;
}

.more-icon {
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.rule-icon {
  background-color: #F1F0E7;
  color: #9A946F;
}

.records-icon {
  background-color: #EAF1E8;
  color: #789477;
}

.more-content {
  flex: 1;
  margin-left: 20rpx;
}

.more-title {
  font-size: 27rpx;
  color: #3D433A;
  font-weight: 550;
}

.more-description {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #A0A097;
}

.more-arrow {
  font-size: 42rpx;
  color: #B9BDB4;
}

.more-divider {
  height: 1rpx;
  margin-left: 88rpx;
  background-color: #F0EFE9;
}

/* 底部寄语 */
.footer-note {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 0 10rpx;
  font-size: 21rpx;
  color: #A3A397;
}

.footer-note text:first-child {
  margin-right: 10rpx;
  color: #91A68B;
}
