.page { padding: 24rpx; background: #f6f7fb; min-height: 100vh; box-sizing: border-box; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; }
.row { display: flex; align-items: center; justify-content: space-between; }
.label { display: block; font-size: 28rpx; font-weight: 600; color: #333; }
.source, .counter { font-size: 22rpx; color: #9aa6c4; }
.words { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx; }
.word { display: flex; align-items: center; gap: 10rpx; padding: 14rpx 22rpx; border: 2rpx solid #e6eaf4; border-radius: 999rpx; font-size: 26rpx; color: #555; background: #fafbff; }
.word.active { border-color: #4a69bd; background: #eef4ff; color: #4a69bd; }
.dot { width: 20rpx; height: 20rpx; border-radius: 50%; background: #dfe4f0; }
.levels { display: flex; gap: 16rpx; margin-top: 24rpx; }
.level { flex: 1; text-align: center; padding: 18rpx 0; border-radius: 12rpx; background: #f4f6fb; color: #667; font-size: 28rpx; }
.level.active { background: #4a69bd; color: #fff; }
.textarea { width: 100%; box-sizing: border-box; min-height: 130rpx; margin-top: 20rpx; background: #f7f8fc; border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 28rpx; }
.submit { margin: 12rpx 0 24rpx; background: #4a69bd; color: #fff; border-radius: 14rpx; }
.result { background: #eaf7ee; border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; }
.result-title { font-size: 30rpx; font-weight: 600; color: #2f7a4b; }
.result-line { font-size: 26rpx; color: #4b7a5e; margin-top: 10rpx; }
.link-btn { margin-top: 20rpx; background: transparent; color: #2f7a4b; font-size: 26rpx; }
.hint { color: #aaa; font-size: 24rpx; }
