<view class="page">
  <view class="card">
    <view class="row">
      <text class="label">今天的心情</text>
      <text class="source">{{source}}</text>
    </view>
    <view class="words">
      <view
        wx:for="{{words}}"
        wx:key="code"
        class="word {{emotion === item.code ? 'active' : ''}}"
        data-code="{{item.code}}"
        bindtap="onSelectEmotion">
        <view class="dot" style="{{item.color ? 'background:' + item.color : ''}}"></view>
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="label">强度 {{intensity}} / {{scale.max}}</view>
    <view class="levels">
      <view
        wx:for="{{levels}}"
        wx:key="*this"
        class="level {{intensity === item ? 'active' : ''}}"
        data-value="{{item}}"
        bindtap="onSelectIntensity">{{item}}</view>
    </view>
  </view>

  <view class="card">
    <view class="row">
      <text class="label">一句话备注（可选）</text>
      <text class="counter">{{noteLength}}/100</text>
    </view>
    <textarea
      class="textarea"
      maxlength="100"
      value="{{note}}"
      placeholder="今天发生了什么…"
      bindinput="onNoteInput" />
  </view>

  <button class="submit" type="primary" disabled="{{submitting}}" bindtap="submit">
    {{submitting ? '提交中…' : '提交打卡'}}
  </button>

  <view wx:if="{{result}}" class="result">
    <view class="result-title">打卡成功</view>
    <view class="result-line">{{result.checkinDate}} · 连续 {{result.streakDays}} 天</view>
    <button class="link-btn" bindtap="goCalendar">去日历看回显 →</button>
  </view>

  <view class="hint">提交后可在打卡日历页看到当天颜色标记；数据由本地 Docker 后端提供。</view>
</view>
