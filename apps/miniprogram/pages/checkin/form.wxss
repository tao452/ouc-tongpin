
/* 页面整体 */
.checkin-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx 40rpx 50rpx;
  background: #F8F7F3;
  color: #30352F;
}

/* 日期 */
.date-text {
  font-size: 25rpx;
  color: #A7A79F;
  margin-bottom: 30rpx;
  letter-spacing: 1rpx;
}

/* 页面标题 */
.page-header {
  margin-bottom: 42rpx;
}

.header-tag {
  display: inline-block;
  padding: 9rpx 17rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: #E8EEE5;
  color: #789477;
  font-size: 19rpx;
  letter-spacing: 2rpx;
}

.page-title {
  font-size: 42rpx;
  font-weight: 600;
  color: #30352F;
  line-height: 1.5;
}

.page-subtitle {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #85877F;
}

/* 通用模块卡片 */
.section {
  padding: 30rpx;
  margin-bottom: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #EAE9E2;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.section-heading {
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #30352F;
}

.section-desc {
  margin-top: 9rpx;
  font-size: 23rpx;
  color: #A7A79F;
}

/* 情绪选择区域 */
.emotion-section {
  padding: 0;
  background: transparent;
  border: none;
}

/* 两列布局 */
.emotion-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

/* 情绪卡片：约 161 × 96px */
.emotion-item {
  position: relative;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: calc((100% - 24rpx) / 2);
  height: 192rpx;
  margin-bottom: 24rpx;
  padding: 0 24rpx;
  border: 1rpx solid transparent;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
}

/* 开心 */
.emotion-HAPPY {
  background: #FFF0D9;
  color: #55432D;
}

/* 平静 */
.emotion-CALM {
  background: #E5EFE3;
  color: #3D5540;
}

/* 焦虑 */
.emotion-ANXIOUS {
  background: #E9EAF5;
  color: #4C506F;
}

/* 孤独 */
.emotion-LONELY {
  background: #F0E8F2;
  color: #5D4C65;
}

/* 烦躁 */
.emotion-IRRITABLE {
  background: #F8E8E0;
  color: #704B3E;
}

/* 低落 */
.emotion-DOWN {
  background: #E5EDF2;
  color: #465B6B;
}

/* 情绪装饰圆点 */
.emotion-dot {
  width: 18rpx;
  height: 18rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.emotion-HAPPY .emotion-dot {
  background: #D69B47;
}

.emotion-CALM .emotion-dot {
  background: #789477;
}

.emotion-ANXIOUS .emotion-dot {
  background: #858BB7;
}

.emotion-LONELY .emotion-dot {
  background: #A58BB1;
}

.emotion-IRRITABLE .emotion-dot {
  background: #CC876C;
}

.emotion-DOWN .emotion-dot {
  background: #819CAF;
}

/* 选中状态 */
.emotion-item.selected {
  background: #789477;
  border-color: #789477;
  color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(120, 148, 119, 0.18);
}

.emotion-item.selected .emotion-dot {
  background: #FFFFFF;
}

/* 选中对勾 */
.selected-mark {
  position: absolute;
  right: 18rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
}

/* 情绪强度 */
.intensity-display {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin: 10rpx 0 20rpx;
}

.intensity-number {
  font-size: 64rpx;
  line-height: 1.2;
  font-weight: 600;
  color: #789477;
}

.intensity-total {
  margin-left: 8rpx;
  font-size: 27rpx;
  color: #A7A79F;
}

.intensity-section slider {
  margin: 20rpx 0;
}

.intensity-hint {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #A7A79F;
}

/* 心情备注 */
.note-input {
  width: 100%;
  min-height: 190rpx;
  padding: 22rpx;
  box-sizing: border-box;
  border: 1rpx solid #EAE9E2;
  border-radius: 16rpx;
  background: #FAFAF7;
  color: #30352F;
  font-size: 26rpx;
  line-height: 1.7;
}

.note-placeholder {
  color: #B5B5AD;
  font-size: 25rpx;
}

.note-count {
  margin-top: 13rpx;
  text-align: right;
  font-size: 22rpx;
  color: #A7A79F;
}

/* 提交按钮 */
.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  line-height: normal;
  margin-top: 38rpx;
  padding: 0;
  border: none;
  border-radius: 20rpx;
  font-size: 29rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.submit-button::after {
  border: none;
}

.submit-button.enabled {
  background: #789477;
  box-shadow: 0 8rpx 20rpx rgba(120, 148, 119, 0.2);
}

.submit-button.disabled {
  background: #B8C5B5;
}

/* 底部寄语 */
.footer-note {
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: #A7A79F;
  letter-spacing: 1rpx;
}
