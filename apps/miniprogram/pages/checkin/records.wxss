.records-page {
    min-height: 100vh;
    box-sizing: border-box;
    padding: 32rpx;
    background-color: #ffffff;
  }

  .data-card {
    display: flex;
    padding: 36rpx 0;
    border: 1rpx solid #d9d9d9;
    border-radius: 24rpx;
    background-color: #ffffff;
  }

  .data-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .data-number {
    font-size: 56rpx;
    font-weight: 700;
    color: #222831;
  }

  .data-label {
    margin-top: 16rpx;
    font-size: 27rpx;
    color: #667085;
  }

  .section-title {
    margin-top: 48rpx;
    margin-bottom: 24rpx;
    font-size: 32rpx;
    font-weight: 700;
    color: #222831;
  }

  .record-list {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
  }

  .record-card {
    padding: 28rpx;
    border: 1rpx solid #d9d9d9;
    border-radius: 20rpx;
    background-color: #ffffff;
  }

  .record-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .record-date {
    font-size: 30rpx;
    font-weight: 600;
    color: #222831;
  }

  .record-status {
    font-size: 25rpx;
    color: #98a2b3;
  }

  .record-summary {
    margin-top: 18rpx;
    font-size: 26rpx;
    color: #667085;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .state-container,
  .empty-container {
    padding: 100rpx 20rpx;
    text-align: center;
  }

  .state-text,
  .empty-text {
    font-size: 28rpx;
    color: #667085;
  }

  .empty-hint {
    margin-top: 16rpx;
    font-size: 24rpx;
    color: #98a2b3;
  }

  .retry-button {
    width: 220rpx;
    height: 72rpx;
    line-height: 72rpx;
    margin-top: 28rpx;
    border-radius: 40rpx;
    background-color: #f0f0f0;
    color: #222831;
    font-size: 26rpx;
  }

  .retry-button::after {
    border: none;
  }
