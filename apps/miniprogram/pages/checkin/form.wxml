
<view class="checkin-page">

  <!-- 日期 -->
  <view class="date-text">{{currentDate}}</view>

  <!-- 页面标题 -->
  <view class="page-header">
    <view class="header-tag">TODAY · CHECK IN</view>
    <view class="page-title">记录此刻的心情</view>
    <view class="page-subtitle">认真感受自己，不必评判情绪</view>
  </view>

  <!-- 情绪选择 -->
  <view class="section emotion-section">
    <view class="section-heading">
      <view class="section-title">今天的心情</view>
      <view class="section-desc">此刻，你感受到什么？</view>
    </view>

    <view class="emotion-list">
      <view
        wx:for="{{words}}"
        wx:key="code"
        class="emotion-item emotion-{{item.code}} {{selectedEmotion === item.code ? 'selected' : ''}}"
        data-code="{{item.code}}"
        bindtap="selectEmotion"
      >
        <view class="emotion-dot"></view>
        <text class="emotion-label">{{item.label}}</text>
        <view
          wx:if="{{selectedEmotion === item.code}}"
          class="selected-mark"
        >✓</view>
      </view>
    </view>
  </view>

  <!-- 情绪强度 -->
  <view class="section intensity-section">
    <view class="section-heading">
      <view class="section-title">情绪强度</view>
      <view class="section-desc">感受一下，这份情绪有多强烈</view>
    </view>

    <view class="intensity-display">
      <view class="intensity-number">{{intensity}}</view>
      <view class="intensity-total">/ {{intensityMax}}</view>
    </view>

    <slider
      min="{{intensityMin}}"
      max="{{intensityMax}}"
      value="{{intensity}}"
      activeColor="#789477"
      backgroundColor="#E8EEE5"
      block-color="#FFFFFF"
      block-size="24"
      bindchange="onIntensityChange"
    />

    <view class="intensity-hint">
      <text>较弱</text>
      <text>较强</text>
    </view>
  </view>

  <!-- 心情备注 -->
  <view class="section note-section">
    <view class="section-heading">
      <view class="section-title">写下此刻的感受</view>
      <view class="section-desc">给自己的心情留下一点空间</view>
    </view>

    <textarea
      class="note-input"
      placeholder="有什么想记录的吗？（选填）"
      placeholder-class="note-placeholder"
      value="{{note}}"
      maxlength="100"
      bindinput="onNoteInput"
    ></textarea>

    <view class="note-count">{{note.length}}/100</view>
  </view>

  <!-- 提交按钮 -->
  <button
    class="submit-button {{selectedEmotion ? 'enabled' : 'disabled'}}"
    bindtap="submitCheckin"
    loading="{{submitting}}"
    disabled="{{submitting}}"
  >
    {{submitting ? '提交中...' : '提交打卡'}}
  </button>

  <!-- 底部提示 -->
  <view class="footer-note">
    每一种情绪，都值得被认真对待
  </view>

</view>
