.page {
    min-height: 100vh;
    box-sizing: border-box;
    padding: 40rpx 32rpx;
    background-color: #f7f8fa;
  }

  .header {
    margin-bottom: 40rpx;
  }

  .title {
    font-size: 40rpx;
    font-weight: 600;
    color: #222222;
  }

  .subtitle {
    margin-top: 14rpx;
    font-size: 26rpx;
    color: #999999;
  }

  .user-card {
    display: flex;
    align-items: center;
    padding: 36rpx 28rpx;
    background-color: #ffffff;
    border-radius: 24rpx;
    margin-bottom: 32rpx;
  }

  .avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 104rpx;
    height: 104rpx;
    border-radius: 50%;
    background-color: #e8f1f5;
    color: #426b7a;
    font-size: 36rpx;
    font-weight: 600;
  }

  .user-info {
    margin-left: 24rpx;
  }

  .nickname {
    font-size: 30rpx;
    font-weight: 600;
    color: #333333;
  }

  .login-status {
    margin-top: 12rpx;
    font-size: 24rpx;
    color: #999999;
  }

  .section {
    margin-bottom: 28rpx;
    padding: 28rpx;
    background-color: #ffffff;
    border-radius: 24rpx;
  }

  .section-title {
    margin-bottom: 24rpx;
    font-size: 28rpx;
    font-weight: 600;
    color: #333333;
  }

  .menu-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 100rpx;
    border-top: 1rpx solid #f0f0f0;
  }

  .menu-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .menu-name {
    font-size: 28rpx;
    color: #333333;
  }

  .menu-desc {
    margin-top: 10rpx;
    font-size: 23rpx;
    color: #999999;
  }

  .menu-right {
    display: flex;
    align-items: center;
  }

  .status-pending,
  .status-normal {
    font-size: 23rpx;
    color: #999999;
  }

  .status-pending {
    color: #c58b45;
  }

  .arrow {
    margin-left: 14rpx;
    font-size: 36rpx;
    color: #bbbbbb;
  }

  .footer {
    margin-top: 60rpx;
    text-align: center;
    font-size: 22rpx;
    color: #bbbbbb;
  }
