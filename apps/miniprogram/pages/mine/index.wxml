<view class="page">
    <view class="header">
      <view class="title">我的</view>
      <view class="subtitle">管理个人信息与校园社交生活</view>
    </view>

    <view class="user-card">
      <view class="avatar">
        {{loginSuccess ? '同' : '未'}}
      </view>

      <view class="user-info">
        <view class="nickname">
          {{loginSuccess ? 'OUC 同频用户' : '欢迎来到 OUC 同频'}}
        </view>

        <view class="login-status">
          <block wx:if="{{!loginReady}}">登录中...</block>
          <block wx:elif="{{loginSuccess}}">已登录</block>
          <block wx:else>暂未登录</block>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">账号与认证</view>

      <view class="menu-item" bindtap="goStudentVerify">
        <view class="menu-left">
          <view class="menu-name">校内身份认证</view>
          <view class="menu-desc">完成学号绑定，开启校园功能</view>
        </view>

        <view class="menu-right">
          <text wx:if="{{needStudentVerify}}" class="status-pending">待认证</text>
          <text wx:else class="status-normal">查看</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">我的记录</view>

      <view class="menu-item" bindtap="goCheckinRecords">
        <view class="menu-left">
          <view class="menu-name">情绪打卡记录</view>
          <view class="menu-desc">回顾自己的情绪变化</view>
        </view>
        <view class="arrow">›</view>
      </view>
    </view>

    <view class="footer">
      OUC 同频 · 让校园生活多一点连接
    </view>
  </view>
