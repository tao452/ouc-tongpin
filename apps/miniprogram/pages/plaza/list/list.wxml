
<view class="page">
  <!-- 数据来源标注：真实接口时不显示；回退 Mock 或压测数据时如实提示 -->
  <view wx:if="{{demoNotice}}" class="demo-notice {{noticeLevel === 'error' ? 'demo-notice-error' : ''}}">
    <text class="demo-notice-icon">!</text>
    <text>{{demoNotice}}</text>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-icon">⌕</view>
    <input
      class="search-input"
      placeholder="搜索你感兴趣的搭子需求"
      placeholder-class="search-placeholder"
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
    />
    <view wx:if="{{searchKeyword}}" class="clear-search" bindtap="onClearSearch">×</view>
  </view>

  <!-- 分类导航 -->
  <scroll-view class="category-scroll" scroll-x="true" show-scrollbar="false">
    <view class="category-list">
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="category-item {{activeCategory === item ? 'active' : ''}}"
        data-value="{{item}}"
        bindtap="onCategoryChange"
      >
        {{item}}
      </view>
    </view>
  </scroll-view>

  <!-- 筛选区域 -->
  <view class="filter-panel">
    <view class="filter-row">
      <picker
        mode="selector"
        range="{{scenes}}"
        bindchange="onSceneChange"
      >
        <view class="filter-picker">
          {{activeScene === '全部' ? '活动场景' : activeScene}}
          <text class="arrow">⌄</text>
        </view>
      </picker>

      <picker
        mode="selector"
        range="{{times}}"
        bindchange="onTimeChange"
      >
        <view class="filter-picker">
          {{activeTime === '全部' ? '活动时间' : activeTime}}
          <text class="arrow">⌄</text>
        </view>
      </picker>

      <picker
        mode="selector"
        range="{{distances}}"
        bindchange="onDistanceChange"
      >
        <view class="filter-picker">
          {{activeDistance === '不限' ? '距离不限' : activeDistance}}
          <text class="arrow">⌄</text>
        </view>
      </picker>
    </view>

    <scroll-view class="tag-scroll" scroll-x="true" show-scrollbar="false">
      <view class="tag-list">
        <view
          wx:for="{{tags}}"
          wx:key="*this"
          class="tag-item {{activeTag === item ? 'tag-active' : ''}}"
          data-value="{{item}}"
          bindtap="onTagChange"
        >
          {{item}}
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 排序栏 -->
  <view class="sort-bar">
    <view
      wx:for="{{sortOptions}}"
      wx:key="*this"
      class="sort-item {{activeSort === item ? 'sort-active' : ''}}"
      data-value="{{item}}"
      bindtap="onSortChange"
    >
      {{item}}
    </view>
  </view>

  <!-- 需求列表 -->
  <view class="need-list">
    <block wx:if="{{filteredNeeds.length > 0}}">

      <!-- 顶部占位 -->
      <view
        class="virtual-spacer"
        style="height: {{topSpacerHeight}}px;"
      ></view>

      <!-- 当前窗口内的卡片 -->
      <view
        wx:for="{{visibleNeeds}}"
        wx:key="id"
        class="virtual-card"
        data-id="{{item.id}}"
      >
        <need-card
          item="{{item}}"
          bind:needtap="onNeedTap"
        ></need-card>
      </view>

      <!-- 底部占位 -->
      <view
        class="virtual-spacer"
        style="height: {{bottomSpacerHeight}}px;"
      ></view>

    </block>

    <!-- 空状态 -->
    <view wx:else class="empty-state">
      <view class="empty-icon">⌕</view>
      <block wx:if="{{dataSource === 'empty'}}">
        <view class="empty-title">广场还没有需求</view>
        <view class="empty-description">去发布一条搭子需求吧</view>
      </block>
      <block wx:else>
        <view class="empty-title">暂时没有找到相关需求</view>
        <view class="empty-description">试试调整筛选条件吧</view>
      </block>
    </view>
  </view>

  <!-- 游标分页状态 -->
  <view wx:if="{{dataSource === 'backend' && loadingMore}}" class="list-footer">正在加载更多…</view>
  <view wx:elif="{{dataSource === 'backend' && !hasNextPage && filteredNeeds.length > 0}}" class="list-footer">已加载全部需求</view>
</view>
