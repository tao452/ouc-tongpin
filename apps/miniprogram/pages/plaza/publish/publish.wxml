<view class="page">
    <!-- 页面标题 -->
    <view class="header">
      <view class="title">发布搭子需求</view>
      <view class="subtitle">描述你的想法，找到志同道合的伙伴</view>
    </view>

    <!-- 场景 -->
    <view class="form-card">
      <view class="form-item">
        <view class="label">
          需求场景
          <text class="required">*</text>
        </view>
        <picker
          mode="selector"
          range="{{sceneOptions}}"
          value="{{sceneIndex}}"
          bindchange="onSceneChange"
        >
          <view class="picker-value {{scene ? '' : 'placeholder'}}">
            {{scene || '请选择需求场景'}}
            <text class="arrow">›</text>
          </view>
        </picker>
      </view>

      <!-- 时间 -->
      <view class="form-item">
        <view class="label">
          期望时间
          <text class="required">*</text>
        </view>
        <view class="time-select">
          <picker
            mode="date"
            start="{{today}}"
            value="{{date}}"
            bindchange="onDateChange"
          >
            <view class="picker-value {{date ? '' : 'placeholder'}}">
              {{date || '选择日期'}}
            </view>
          </picker>

          <picker
            mode="time"
            value="{{time}}"
            bindchange="onTimeChange"
          >
            <view class="picker-value {{time ? '' : 'placeholder'}}">
              {{time || '选择时间'}}
            </view>
          </picker>
        </view>
      </view>

      <!-- 地点 -->
      <view class="form-item">
        <view class="label">
          活动地点
          <text class="required">*</text>
        </view>
        <view class="location-select" bindtap="chooseLocation">
          <text class="{{location.address ? 'location-text' : 'placeholder'}}">
            {{location.address || '请选择活动地点'}}
          </text>
          <text class="arrow">›</text>
        </view>
      </view>

      <!-- 技能标签 -->
      <view class="form-item">
        <view class="label-row">
          <view class="label">技能标签</view>
          <view class="count">{{skillTags.length}}/5</view>
        </view>

        <view class="tag-list">
          <view
            class="selected-tag"
            wx:for="{{skillTags}}"
            wx:key="*this"
          >
            {{item}}
            <text
              class="remove-tag"
              data-index="{{index}}"
              catchtap="removeTag"
            >×</text>
          </view>
        </view>

        <view class="tag-input-row">
          <input
            class="tag-input"
            placeholder="输入标签，例如：羽毛球、考研"
            value="{{tagInput}}"
            bindinput="onTagInput"
            maxlength="12"
          />
          <button
            class="add-tag-button"
            bindtap="addTag"
            disabled="{{skillTags.length >= 5}}"
          >添加</button>
        </view>
        <view class="hint">最多添加 5 个标签</view>
      </view>

      <!-- 补充说明 -->
      <view class="form-item last-item">
        <view class="label-row">
          <view class="label">补充说明</view>
          <view class="count">{{remark.length}}/200</view>
        </view>
        <textarea
          class="remark-input"
          placeholder="介绍一下你的需求，让大家更了解你吧..."
          value="{{remark}}"
          bindinput="onRemarkInput"
          maxlength="200"
        />
      </view>
    </view>

    <!-- 发布按钮 -->
    <button
      class="submit-button"
      bindtap="submitNeed"
      loading="{{submitting}}"
      disabled="{{submitting}}"
    >
      发布需求
    </button>

    <view class="footer-tip">
      请认真填写需求信息，友善交流，共建安全的校园社交环境
    </view>
  </view>
