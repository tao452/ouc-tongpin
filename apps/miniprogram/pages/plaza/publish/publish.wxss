.page {
    min-height: 100vh;
    padding: 32rpx;
    padding-bottom: 60rpx;
    box-sizing: border-box;
    background-color: #f7f8fa;
  }

  .header {
    margin-bottom: 32rpx;
  }

  .title {
    font-size: 40rpx;
    font-weight: 700;
    color: #263b35;
  }

  .subtitle {
    margin-top: 12rpx;
    font-size: 25rpx;
    color: #89948f;
  }

  .form-card {
    padding: 8rpx 28rpx;
    border-radius: 20rpx;
    background-color: #ffffff;
  }

  .form-item {
    padding: 28rpx 0;
    border-bottom: 1rpx solid #edf0ee;
  }

  .last-item {
    border-bottom: none;
  }

  .label {
    margin-bottom: 20rpx;
    font-size: 28rpx;
    font-weight: 600;
    color: #34463e;
  }

  .required {
    margin-left: 8rpx;
    color: #d87969;
  }

  .picker-value,
  .location-select {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 76rpx;
    padding: 0 22rpx;
    border-radius: 12rpx;
    background-color: #f7f8f7;
    font-size: 26rpx;
    color: #34463e;
  }

  .placeholder {
    color: #a5ada8;
  }

  .arrow {
    color: #a5ada8;
    font-size: 34rpx;
  }

  .time-select {
    display: flex;
    gap: 18rpx;
  }

  .time-select picker {
    flex: 1;
    min-width: 0;
  }

  .location-text {
    flex: 1;
    font-size: 26rpx;
    color: #34463e;
  }

  .label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .label-row .label {
    margin-bottom: 20rpx;
  }

  .count {
    font-size: 22rpx;
    color: #a0aaa5;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 14rpx;
    margin-bottom: 20rpx;
  }

  .selected-tag {
    display: flex;
    align-items: center;
    padding: 10rpx 18rpx;
    border-radius: 10rpx;
    background-color: #edf5ef;
    color: #5d8b70;
    font-size: 23rpx;
  }

  .remove-tag {
    margin-left: 12rpx;
    font-size: 28rpx;
    color: #82968b;
  }

  .tag-input-row {
    display: flex;
    align-items: center;
    gap: 16rpx;
  }

  .tag-input {
    flex: 1;
    min-width: 0;
    height: 76rpx;
    padding: 0 20rpx;
    box-sizing: border-box;
    border-radius: 12rpx;
    background-color: #f7f8f7;
    font-size: 24rpx;
  }

  .add-tag-button {
    width: 112rpx;
    height: 76rpx;
    line-height: 76rpx;
    padding: 0;
    border-radius: 12rpx;
    background-color: #edf5ef;
    color: #5d8b70;
    font-size: 24rpx;
  }

  .add-tag-button::after {
    border: none;
  }

  .add-tag-button[disabled] {
    opacity: 0.5;
  }

  .hint {
    margin-top: 14rpx;
    font-size: 21rpx;
    color: #a0aaa5;
  }

  .remark-input {
    width: 100%;
    min-height: 200rpx;
    padding: 20rpx;
    box-sizing: border-box;
    border-radius: 12rpx;
    background-color: #f7f8f7;
    font-size: 25rpx;
    line-height: 1.6;
  }

  .submit-button {
    width: 100%;
    height: 88rpx;
    margin-top: 36rpx;
    line-height: 88rpx;
    border-radius: 18rpx;
    background-color: #719982;
    color: #ffffff;
    font-size: 29rpx;
    font-weight: 600;
  }

  .submit-button::after {
    border: none;
  }

  .submit-button[disabled] {
    opacity: 0.6;
  }

  .footer-tip {
    margin: 22rpx 12rpx 0;
    text-align: center;
    font-size: 21rpx;
    line-height: 1.6;
    color: #a0aaa5;
  }
