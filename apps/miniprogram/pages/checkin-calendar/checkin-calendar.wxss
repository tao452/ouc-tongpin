.page { padding: 24rpx; }
.header { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; }
.ym { font-size: 34rpx; font-weight: 700; }
.nav { width: 64rpx; height: 64rpx; line-height: 60rpx; text-align: center; font-size: 40rpx; border-radius: 50%; background: #fff; }
.streak { text-align: center; margin: 16rpx 0 24rpx; }
.streak .big { font-size: 64rpx; font-weight: 800; color: #4a69bd; margin-right: 12rpx; }
.streak .label { color: #888; font-size: 26rpx; }
.week-row, .grid { display: flex; flex-wrap: wrap; }
.week-cell, .cell { width: 14.28%; text-align: center; padding: 16rpx 0; box-sizing: border-box; }
.week-cell { color: #999; font-size: 24rpx; }
.cell { border-radius: 12rpx; margin: 4rpx 0; color: #555; }
.cell.empty { background: transparent; }
.cell.checked { color: #fff; font-weight: 700; }
.remind { display: flex; align-items: center; gap: 16rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; margin-top: 24rpx; }
.remind-title { font-weight: 600; flex: 1; }
.remind-time { color: #4a69bd; }
.hint { color: #aaa; font-size: 22rpx; margin-top: 16rpx; }
