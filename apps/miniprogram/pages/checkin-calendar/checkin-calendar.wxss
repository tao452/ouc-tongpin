
/* 页面整体 */
.page {
  min-height: 100vh;
  padding: 32rpx 40rpx 48rpx;
  box-sizing: border-box;
  background: #F8F7F3;
  color: #30352F;
}

/* 月份切换 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0 24rpx;
}

.ym {
  font-size: 34rpx;
  font-weight: 700;
  color: #30352F;
}

.nav {
  width: 64rpx;
  height: 64rpx;
  line-height: 58rpx;
  text-align: center;
  font-size: 40rpx;
  color: #789477;
  border-radius: 50%;
  background: #FFFFFF;
}

/* 连续打卡 */
.streak {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 20rpx 0 32rpx;
}

.streak .big {
  font-size: 76rpx;
  line-height: 1.3;
  font-weight: 800;
  color: #789477;
}

.streak .label {
  margin-top: 8rpx;
  color: #85877F;
  font-size: 25rpx;
}

/* 日历卡片 */
.calendar-card {
  padding: 20rpx 12rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(65, 75, 60, 0.04);
}

.week-row,
.grid {
  display: flex;
  flex-wrap: wrap;
}

.week-cell,
.cell {
  width: 14.2857%;
  text-align: center;
  box-sizing: border-box;
}

.week-cell {
  padding: 16rpx 0 20rpx;
  color: #A7A79F;
  font-size: 23rpx;
}

.cell {
  height: 76rpx;
  margin: 4rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  color: #555B52;
  font-size: 25rpx;
}

.cell.empty {
  background: transparent;
}

.cell.checked {
  color: #FFFFFF;
  font-weight: 700;
}

/* develop 原有六种情绪颜色，全部保留 */
.cell.emotion-HAPPY {
  background-color: #FFD93D;
}

.cell.emotion-CALM {
  background-color: #95E1D3;
}

.cell.emotion-ANXIOUS {
  background-color: #FF9F68;
}

.cell.emotion-LONELY {
  background-color: #A6B1E1;
}

.cell.emotion-IRRITABLE {
  background-color: #FF6B6B;
}

.cell.emotion-DOWN {
  background-color: #6C7A89;
}

/* 打卡提醒 */
.remind {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-top: 28rpx;
}

.remind-info {
  flex: 1;
  min-width: 180rpx;
}

.remind-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #A7A79F;
}

.remind-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #30352F;
}


.remind-time {
  margin-top: 0;
  padding: 12rpx 18rpx;
  background: #F3F5EF;
  border-radius: 10rpx;
  color: #789477;
  font-size: 24rpx;
}

/* 去打卡按钮 */
.checkin-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 36rpx 0 0;
  height: 88rpx;
  line-height: normal;
  padding: 0;
  border-radius: 16rpx;
  background: #789477;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
}

.checkin-button::after {
  border: none;
}

/* 底部提示 */
.hint {
  color: #A7A79F;
  font-size: 21rpx;
  line-height: 1.6;
  margin-top: 20rpx;
  text-align: center;
}

/* 加载失败提示：保留 develop 样式功能 */
.error-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #FFF3F0;
  border-radius: 14rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
}

.error-text {
  flex: 1;
  color: #B96858;
  font-size: 24rpx;
}

.retry-button {
  margin: 0;
  color: #B96858;
}
