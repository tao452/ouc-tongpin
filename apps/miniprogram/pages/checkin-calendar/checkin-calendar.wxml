
<view class="page">
  <!-- 月份切换 -->
  <view class="header">
    <view class="nav" bindtap="prevMonth">‹</view>
    <view class="ym">{{year}} 年 {{month}} 月</view>
    <view class="nav" bindtap="nextMonth">›</view>
  </view>

  <!-- 连续打卡 -->
  <view class="streak">
    <text class="big">{{streakDays}}</text>
    <text class="label">连续打卡天 · 本月 {{monthTotal}} 次</text>
  </view>

  <!-- 加载失败提示 -->
  <view wx:if="{{loadError}}" class="error-bar">
    <text class="error-text">本月打卡数据加载失败</text>
    <button class="retry-button" size="mini" bindtap="retryLoad">重试</button>
  </view>

  <!-- 日历卡片 -->
  <view class="calendar-card">
    <view class="week-row">
      <view class="week-cell" wx:for="{{week}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="grid">
      <view
        wx:for="{{cells}}"
        wx:for-item="item"
        wx:key="key"
        class="cell {{item.empty ? 'empty' : ''}} {{item.emotion ? 'checked emotion-' + item.emotion : ''}}">
        <text wx:if="{{!item.empty}}">{{item.day}}</text>
      </view>
    </view>
  </view>

  <!-- 打卡提醒 -->
  <view class="remind">
    <view class="remind-info">
      <view class="remind-title">每日打卡提醒</view>
      <view class="remind-desc">设置提醒时间，不错过每一天</view>
    </view>

    <switch
      checked="{{remindOn}}"
      bindchange="toggleRemind"
      color="#789477"
    />

    <picker mode="time" value="{{remindTime}}" bindchange="onTime">
      <view class="remind-time">每日 {{remindTime}}</view>
    </picker>
  </view>

  <!-- 去打卡 -->
  <button class="checkin-button" type="primary" bindtap="goCheckin">
    去打卡
  </button>

  <view class="hint">
    提醒时间由后端定时任务推送（US-02 后端部分，待 M5 骨架就绪后接入）
  </view>
</view>
