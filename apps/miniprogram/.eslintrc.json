{
  "root": true,
  "env": {
    "es2021": true,
    "node": true,
    "browser": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "ignorePatterns": ["miniprogram_npm/**", "node_modules/**"],
  "globals": {
    "wx": "readonly",
    "App": "readonly",
    "Page": "readonly",
    "Component": "readonly",
    "Behavior": "readonly",
    "getApp": "readonly",
    "getCurrentPages": "readonly"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "error"
  }
}
